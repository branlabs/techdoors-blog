{
  "name": "techdoors-blog",
  "version": "1.0.0",
  "private": true,
  "description": "TechDoors — ghi chép về hạ tầng và kỹ thuật phần mềm",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3000 --no-open",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "playwright test",
    "generate:og": "node scripts/create-og.mjs",
    "format": "prettier --write src plugins scripts tests *.ts *.json .github",
    "verify": "npm run typecheck && npm run build && npm run check:site && npm run test:e2e"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "2.0.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-pages": "3.10.2",
    "@docusaurus/plugin-sitemap": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "tinypool": "2.1.2",
    "serialize-javascript": "7.1.3",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
